FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     reactingFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.05;           // ~190 jet flow-through times (L/U = 0.26 ms)

deltaT          1e-7;           // initial step; Co<0.5 limits to ~9e-8 s near inlet

writeControl    adjustableRunTime;
writeInterval   0.01;           // 5 write times
purgeWrite      0;

writeFormat     binary;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;
adjustTimeStep  yes;
maxCo           0.5;            // critical for near-inlet supersonic-ish flow

functions
{
    #includeFunc  singleGraph_z
    #includeFunc  singleGraph_r10
    #includeFunc  singleGraph_r20
    #includeFunc  singleGraph_r30
    #includeFunc  singleGraph_r40
    #includeFunc  singleGraph_r50
    #includeFunc  singleGraph_r60
}


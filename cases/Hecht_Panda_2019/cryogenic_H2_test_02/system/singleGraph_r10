FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      singleGraph_r10;
}
// Radial profile at z = 10 mm from nozzle exit (H&P measurement plane).

type            sets;
libs            (sampling);

writeControl    writeTime;
interpolationScheme cellPoint;
setFormat       raw;

sets
{
    radial_z10mm
    {
        type    lineUniform;
        axis    x;
        start   (0     0 0.0100);
        end     (0.05  0 0.0100);
        nPoints 200;
    }
}

fields ( T H2 U );


FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// Test 1: T_nn = 43.9 K. Ambient: 293.15 K.

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293.15;

boundaryField
{
    inlet_air
    {
        type            fixedValue;
        value           uniform 293.15;
    }
    wallPipe
    {
        type            inletOutlet;
        inletValue      uniform 293.15;
        value           uniform 293.15;
    }
    internalWalls
    {
        type            zeroGradient;
    }
    inlet_fuel
    {
        // Notional nozzle temperature. Update T_nn per test condition.
        type            fixedValue;
        value           uniform 43.9;
    }
    outlet
    {
        type            zeroGradient;
    }
    "(front|back)"
    {
        type            wedge;
    }
}


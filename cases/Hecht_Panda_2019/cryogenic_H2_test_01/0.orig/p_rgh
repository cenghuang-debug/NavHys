FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Dynamic pressure: p_rgh = p - rho*g*h.
// At z=0 (inlet, hRef=0): p_rgh = p = 101325 Pa.

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    nozzleInlet
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    nozzleWall
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    bottomWall
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    outlet
    {
        type            fixedValue;
        value           $internalField;
    }
    "(front|back)"
    {
        type            wedge;
    }
    axis
    {
        type            symmetry;
    }
}


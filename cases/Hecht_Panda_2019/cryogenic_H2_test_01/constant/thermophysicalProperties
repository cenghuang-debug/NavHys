// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Non-reacting H2/air mixture for cryogenic dispersion — Hecht & Panda (2019).
//
// H2  : para-H2 tabulated from CoolProp 'parahydrogen' (Leachman et al. 2009
//        EOS, identical to NIST REFPROP).  Covers 50–350 K at 1 atm.
//        h = 0 at T_ref = 298.15 K.
// air : tabulated from GRI3.0 JANAF low-range coefficients (valid 200–1000 K;
//        extrapolation to 50 K introduces < 2 % error in Cp since air Cp is
//        nearly constant at ~990–1015 J/kg/K over this range).
//        h = 0 at T_ref = 298.15 K (consistent with H2 reference).
// transport : Sutherland for both species (mu = As*T^1.5 / (T + Ts)).
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            hePsiThermo;
    mixture         multiComponentMixture;
    transport       sutherland;
    thermo          hTabulated;
    energy          sensibleEnthalpy;
    equationOfState perfectGas;
    specie          specie;
}

species
(
    H2
    air
);

inertSpecie air;

